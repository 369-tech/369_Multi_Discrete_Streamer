export interface FilterOptions {
  clients: string[]
  brokers: string[]
  instruments: string[]
  option_types: string[]
  transaction_types: string[]
  trade_date_min: string | null
  trade_date_max: string | null
  expiry_date_min: string | null
  expiry_date_max: string | null
}

export interface GlobalFilters {
  [key: string]: string | number | boolean | string[] | undefined
  client_ids?: string[]
  broker?: string
  instrument?: string
  option_type?: string
  transaction_type?: string
  start_date?: string
  end_date?: string
  expiry_start?: string
  expiry_end?: string
  search?: string
}

// Single-horizon KPI set (Sept 2026 simplification — see backend
// app/routers/overview.py module docstring). Everything here reflects
// whatever's currently selected in the global filter bar, which
// defaults to 1 Apr (FY start) through today.
export interface Kpis {
  clients: number
  instruments: number
  brokers: number
  aum: number
  aum_as_of_date: string | null
  investment_amount: number
  investment_amount_as_of_date: string | null
  weighted_investment_amount: number
  gross_pnl: number
  net_pnl: number
  net_pnl_available: boolean
  missing_brokers: string[]
  return_pct: number
  annualised_return_pct: number
  round_trips: number
  win_rate: number
  trade_start_day: string | null
  trade_end_day: string | null
}

export interface TradeRow {
  ClientId: string
  Broker: string
  Current_Date_: string
  Expiry_Date: string
  Execution_Time: string
  Instrument: string
  Strike_Price: string
  Option_Type: string
  Price: string
  Transaction_Type: string
  Quantity: string
  Identifier: string
  trade_value?: number
}

export interface TradePage {
  total: number
  page: number
  page_size: number
  total_pages: number
  rows: TradeRow[]
}

// Gross P&L summary for a set of round trips. When broker charges are
// configured, net_pnl_available is true and net_pnl/net_pnl_missing_brokers
// are populated too — see /pnl/summary on the backend.
export interface ProfitSummary {
  gross_profit: number
  gross_loss: number
  gross_pnl: number
  winning_round_trips: number
  losing_round_trips: number
  round_trips: number
  expiry_closures: number
  win_rate: number
  net_pnl?: number | null
  net_pnl_available?: boolean
  net_pnl_missing_brokers?: string[]
}

export interface RoundTrip {
  ClientId: string
  Broker: string
  Instrument: string
  Strike_Price: string
  Option_Type: string
  Expiry_Date: string
  entry_time: string
  exit_time: string
  entry_price: number
  exit_price: number
  quantity: number
  entry_type: string
  exit_type: string
  net_pnl: number
}

export interface OpenPosition {
  ClientId: string
  Broker: string
  Instrument: string
  Strike_Price: string
  Option_Type: string
  Expiry_Date: string
  open_quantity: number
  avg_entry_price: number
  entry_time: string
  expiry_datetime: string
  days_to_expiry: number | null
  side: 'SELL' | 'BUY'
}

// One row of the "Net P&L by client" or "Net P&L by broker" table.
// One row of the "Net P&L by client" or "Net P&L by broker" table.
// Executions/Round Trips are not shown here anymore (they live on Risk
// & Analytics only) — Investment/AUM (Weighted), a single dual-sourced
// column, takes their place on the by-client table (collapsed back from
// an earlier two-column version).
export interface NetPnlRow {
  ClientId?: string
  ClientName?: string
  Broker?: string
  account_type?: string | null
  absolute_turnover: number
  Gross_PnL: number
  Brokerage: number
  STT: number
  SEBI: number
  StampDuty: number
  NSE_TransactionCharges: number
  CM: number
  GST: number
  Total_Charges: number
  Net_PnL: number
  investment_aum_weighted?: number
  pnl_weightage_pct?: number
  aum?: number
}

export interface NetPnlResponse {
  rows: NetPnlRow[]
  missing_brokers: string[]
  available: boolean
}

// Client Comparison table row. Executions/Round Trips removed (Risk &
// Analytics only, per the Sept 2026 table cleanup) — Investment/AUM
// (Weighted) takes their place.
export interface ClientSummaryRow {
  ClientId: string
  ClientName?: string
  quantity: number
  execution_value: number
  turnover: number
  gross_profit: number
  gross_loss: number
  gross_pnl: number
  expiry_closures: number
  win_rate: number
  investment_aum_weighted?: number
  pnl_weightage_pct?: number
}

export interface StrategyPerformance {
  Instrument: string
  Option_Type: string
  strategy: string
  round_trips: number
  gross_profit: number
  gross_loss: number
  gross_pnl: number
  expiry_closures: number
  win_rate: number
}

